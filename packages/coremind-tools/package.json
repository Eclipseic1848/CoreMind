{
  "name": "coremind-tools",
  "version": "1.1.0",
  "description": "CoreMind 工具层：内置工具注册表与自定义脚本工具加载",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eclipseic1848/CoreMind.git",
    "directory": "packages/coremind-tools"
  },
  "homepage": "https://github.com/Eclipseic1848/CoreMind#readme",
  "bugs": {
    "url": "https://github.com/Eclipseic1848/CoreMind/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node ../../scripts/build-linux-sandbox-backend.mjs --copy-only && node ../../scripts/build-windows-mcp-service.mjs --copy-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "coremind-config": "1.1.0",
    "diff": "9.0.0",
    "execa": "10.0.1",
    "undici": "8.10.2"
  }
}
