{
  "name": "coremind-cli",
  "version": "0.3.0-rc.2",
  "description": "CoreMind CLI：脚手架与运行器（coremind create / run / chat ...）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eclipseic1848/CoreMind.git",
    "directory": "packages/coremind-cli"
  },
  "homepage": "https://github.com/Eclipseic1848/CoreMind#readme",
  "bugs": {
    "url": "https://github.com/Eclipseic1848/CoreMind/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "coremind": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "coremind-ai": "0.3.0-rc.2",
    "dotenv": "^17.4.2",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "ink-testing-library": "4.0.0"
  }
}
