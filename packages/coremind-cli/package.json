{
  "name": "coremind-cli",
  "version": "0.1.0-alpha.2",
  "description": "CoreMind CLI：脚手架与运行器（coremind create / run / chat ...）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "coremind": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "coremind-ai": "0.1.0-alpha.2",
    "coremind-config": "0.1.0-alpha.2",
    "coremind-templates": "0.1.0-alpha.2",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
